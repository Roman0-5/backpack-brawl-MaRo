direction: right

classes: {
  done: { style: { fill: "#d1fae5"; stroke: "#059669"; font-color: "#064e3b" } }
  part: { style: { fill: "#fef3c7"; stroke: "#d97706"; font-color: "#78350f" } }
  todo: { style: { fill: "#fee2e2"; stroke: "#dc2626"; font-color: "#7f1d1d"; stroke-dash: 4 } }
}

legend: "Legende (Stand 2026-11-21, nach B1–B5)" {
  d: "fertig / bleibt\n✓ = umgesetzt" { class: done }
  p: "teilweise umgesetzt,\noffene B# folgen" { class: part }
  t: "neu, noch offen (B#)" { class: todo }
}

browser: Browser (React + Vite) {
  pages: Pages {
    start: StartPage { class: done }
    shop: "ShopPage\nB1 ✓ Verkaufen/Reroll-Buttons\nB5 ✓ Suchzustand, Fehlermeldung, Retry" { class: done }
    battle: "BattlePage / BattleView\nB3 ✓ Poison-Zähler, Log-Farben\nB4 ✓ Burn-Zähler, Set-Badges,\naktive Sets + Fortschritt" { class: done }
    result: "ResultPage\nB7: Name + Submit" { class: part }
    hof: "HallOfFamePage\nB7" { class: todo }
  }
  components: Komponenten {
    backpack: "Backpack.tsx\nB1 ✓ Verkaufen\nB2 ✓ Auswahl, mögliche Züge, Abbrechen\nB4 ✓ Set-Badges, Set-Fortschritt" { class: done }
    setbadge: "SetBadge.tsx\nB4 ✓ Badge + Bonus-Tooltip\n(Shop, Rucksack, Kampf)" { class: done }
    rulespanel: "RulesPanel / rules.ts\nB1–B4 ✓ Regeltexte, Tooltips" { class: done }
  }
  state: State {
    provider: "GameProvider\n(nur useState)\nB6: Save laden/schreiben" { class: part }
    save: "Save-Modul (localStorage)\nB6: Validierung + Fallback" { class: todo }
  }
  rules: Regeln (reines TS, ohne React) {
    run: "run.ts\nkaufen\nB1 ✓ verkaufen, reroll\nB2 ✓ verschieben / tauschen" { class: done }
    shopts: "shop.ts\nseeded RNG" { class: done }
    game: "game.ts\nPhasen\nB5 ✓ Such-ID, Runden-Guard" { class: done }
    api: "api.ts\nB5 ✓ Timeout, Laufzeitprüfung,\nverständliche Fehler" { class: done }
    battle: "battle.ts\nDamage + Block\nB3 ✓ Poison (Stacks, Tick), Heal\nB4 ✓ Burn (Block, halbiert sich),\nSet-Boni beim Fighter-Bau" { class: done }
    sets: "sets.ts\nB4 ✓ Fire + Iron, ab 2 verschiedenen Items,\nBoni für Spieler und Gegner" { class: done }
    items: "items.ts\n15 Items\nB3 ✓ je 3 Poison- und Heal-Items\nB4 ✓ 3 Fire-Items, Iron aus Schilden" { class: done }
  }
  tests: "Vitest-Tests (93)\nrun (B1, B2), battle, items (B3, B4),\nsets (B4), game, api (B5)" { class: done }
}

server: Express API {
  health: "GET /api/health" { class: done }
  opp: "GET /api/opponents\nB3 ✓ Poison/Heal\nB4 ✓ Gegner mit Fire-/Iron-Set" { class: done }
  runs: "POST / GET /api/runs\nB7: Validierung, Ranking,\nIn-Memory" { class: todo }
}

browser.pages.shop -> browser.rules.run
browser.pages.shop -> browser.components.backpack
browser.components.backpack -> browser.rules.run
browser.components.backpack -> browser.rules.sets
browser.pages.shop -> browser.rules.game
browser.pages.shop -> browser.rules.api
browser.pages.battle -> browser.rules.battle
browser.rules.battle -> browser.rules.sets
browser.rules.battle -> browser.rules.items
browser.rules.sets -> browser.rules.items
browser.rules.game -> browser.state.provider
browser.state.provider -> browser.state.save: B6 { style.stroke-dash: 4 }
browser.rules.api -> server.opp: fetchOpponent { style.stroke: "#059669" }
browser.pages.result -> server.runs: B7 { style.stroke-dash: 4; style.stroke: "#dc2626" }
browser.pages.hof -> server.runs: B7 { style.stroke-dash: 4; style.stroke: "#dc2626" }
