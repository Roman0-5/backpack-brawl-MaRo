grid-columns: 1
grid-gap: 24

classes: {
  fe: { style: { fill: "#dbeafe"; stroke: "#2563eb"; font-color: "#1e3a8a" } }
  be: { style: { fill: "#ffedd5"; stroke: "#ea580c"; font-color: "#7c2d12" } }
  none: { style: { fill: "#f3f4f6"; stroke: "#9ca3af"; font-color: "#6b7280"; stroke-dash: 4 } }
  shared: { style: { fill: "#ede9fe"; stroke: "#7c3aed"; font-color: "#4c1d95" } }
}

legend: Legende {
  grid-columns: 4
  f: Frontend (src/) { class: fe }
  b: Backend (server/) { class: be }
  s: Vertrag FE<->BE { class: shared }
  n: nichts nötig { class: none }
}

reqs: "Anforderungen (✓ = umgesetzt und gemergt, Stand 2026-11-22)" {
  grid-columns: 2
  grid-gap: 20

  b1: "B1 Shop-Wirtschaft · 10% · Matthias ✓" {
    fe: "FE ✓\nverkaufen (Preis/2 abgerundet), Reroll 1🪙\natomare Regeln in run.ts\nButtons + Grund, warum gesperrt" { class: fe }
    be: "BE\nkeine Änderung" { class: none }
  }
  b2: "B2 Backpack anordnen · 15% · Matthias ✓" {
    fe: "FE ✓\nAuswahl, Move/Swap, mögliche Ziele,\nAbbrechen (Backpack.tsx + run.ts)" { class: fe }
    be: "BE\nkeine Änderung" { class: none }
  }
  b3: "B3 Poison / Heal · 15% · Roman ✓" {
    fe: "FE ✓\nbattle.ts (Poison-Tick, Heal), 6 neue Items,\nPoison-Zähler, Log, Rules, Tooltips, 24 Tests" { class: fe }
    be: "BE ✓\nopponents.js: Gegner ab Runde 3\nnutzen Poison/Heal" { class: be }
  }
  b4: "B4 Sets + Burn · 20% · Roman ✓" {
    fe: "FE ✓\nsets.ts (Fire, Iron), Boni beim Fighter-Bau, Burn,\nBadges, Set-Fortschritt, Burn-Zähler, Rules, 27 Tests" { class: fe }
    be: "BE ✓\nopponents.js: Gegner mit Fire-/Iron-Set" { class: be }
  }
  b5: "B5 Matchmaking · 10% · Matthias ✓" {
    fe: "FE ✓\nSuch-ID + Runden-Guard, Phase nach Fehler,\nDoppelstart sperren, Fehlermeldung + Retry" { class: fe }
    be: "BE\nkeine Änderung\n(latency/fail-Parameter zum Testen vorhanden)" { class: none }
  }
  b6: "B6 Save / Resume · 10% · Matthias ✓" {
    fe: "FE ✓\nsave.ts: localStorage, Validierung, Fallback,\nPolicy bei Refresh in Suche/Replay, Continue run" { class: fe }
    be: "BE\nkeine Änderung" { class: none }
  }
  b7: "B7 Hall of Fame · 20% · Roman ✓" {
    fe: "FE ✓\nName am Run-Ende, eigene Seite,\nLaden/Leer/Fehler, Retry, kein Doppel-Submit,\nrunId im Save" { class: fe }
    be: "BE ✓\nServer auf TypeScript (tsx),\nPOST + GET, Plausibilität, Ranking,\nIn-Memory-Store, docs/API.md" { class: be }
    api: "Vertrag ✓: Typen in server/runs.ts,\nClient per import type, Fehlerformat { error }" { class: shared }
    fe -> api
    be -> api
  }
  nf: "Qualitätsziele" {
    both: "beide: Ziele wählen, begründen,\nevaluieren, mündlich verteidigen" { class: shared }
  }
}

summary: "Einschätzung (Schätzung, kein Messwert)" {
  a: "Backend-Anteil: B7 (Server) + kleine Gegner-Änderungen\n≈ 20–25 % der Arbeit" { class: be }
  b: "Frontend-Anteil: alles andere ≈ 75–80 %\n→ reine FE/BE-Teilung ist stark unausgewogen" { class: fe }
}

hot: "Konfliktstellen bei paralleler Arbeit" {
  a: "types.ts, battle.ts, items.ts\n(B3 ✓ + B4 ✓: beide Roman, nacheinander)" { class: none }
  b: "run.ts, Backpack.tsx\n(B1 ✓ + B2 ✓: beide Matthias)" { class: none }
  c: "game.ts, ShopPage.tsx, GameProvider.tsx\n(B5 ✓ + B6 ✓: beide Matthias)" { class: none }
  e: "rules.ts: Regeltexte von allen Features\n(nur neue Abschnitte anhängen)" { class: none }
  f: "save.ts: B6 (Matthias), von B7 um runId\nund submitted erweitert (Version 2)" { class: none }
  d: "UI-Redesign berührt fast alle Komponenten" { class: none }
}
